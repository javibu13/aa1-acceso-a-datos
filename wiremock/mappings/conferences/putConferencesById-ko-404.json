{
    "priority": 2,
    "request": {
        "method": "PUT",
        "urlPattern": "/conferences/([0-9]+)",
        "headers": {
            "Content-Type": {
                "equalTo": "application/json"
            }
        },
        "bodyPatterns": [
            {
                "matchesJsonPath": "$[?(@.name && @.name =~ /^[a-zA-Z0-9 ]{3,50}$/)]"
            },
            {
                "matchesJsonPath": "$[?(@.capacity && @.capacity =~ /^[0-9]{1,3}$/)]"
            },
            {
                "matchesJsonPath": "$[?(@.budget && @.budget =~ /^[0-9]{1,6}$/)]"
            },
            {
                "matchesJsonPath": "$[?(@.online == true || @.online == false)]"
            },
            {
                "matchesJsonPath": "$[?(@.startDate && @.startDate =~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)]"
            },
            {
                "matchesJsonPath": "$[?(@.place && @.place =~ /^[0-9]+$/)]"
            },
            {
                "matchesJsonPath": "$[?(@.organizer && @.organizer =~ /^[0-9]+$/)]"
            }
        ]
    },
    "response": {
        "status": 404,
        "headers": {
            "Content-Type": "application/json"
        },
        "bodyFileName": "conferences/errorResponse-404.json"
    }
}