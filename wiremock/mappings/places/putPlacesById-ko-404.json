{
    "priority": 2,
    "request": {
        "method": "PUT",
        "urlPattern": "/places/([0-9]+)",
        "headers": {
            "Content-Type": {
                "equalTo": "application/json"
            }
        },
        "bodyPatterns": [
            {
                "matchesJsonPath": "$[?(@.name)]"
            },
            {
                "matchesJsonPath": "$[?(@.address)]"
            },
            {
                "matchesJsonPath": "$[?(@.capacity =~ /^[0-9]+$/)]"
            },
            {
                "matchesJsonPath": "$[?(@.area =~ /^[0-9]+$/)]"
            },
            {
                "matchesJsonPath": "$[?(@.inaugurationDate =~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)]"
            },
            {
                "matchesJsonPath": "$[?(@.hasParking == true || @.hasParking == false)]"
            },
            {
                "matchesJsonPath": "$[?(@.equipment)]"
            }
        ]
    },
    "response": {
        "status": 404,
        "headers": {
            "Content-Type": "application/json"
        },
        "bodyFileName": "places/errorResponse-404.json"
    }
}