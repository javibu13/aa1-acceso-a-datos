{
    "priority": 2,
    "request": {
        "method": "PUT",
        "urlPattern": "/persons/([0-9]+)",
        "headers": {
            "Content-Type": {
                "equalTo": "application/json"
            }
        },
        "bodyPatterns": [
            {
                "matchesJsonPath": "$[?(@.firstName)]"
            },
            {
                "matchesJsonPath": "$[?(@.lastName)]"
            },
            {
                "matchesJsonPath": "$[?(@.email =~ /^[^@]+@[^@]+\\.[^@]+$/)]"
            },
            {
                "matchesJsonPath": "$[?(@.pass =~ /^[a-f0-9]{40}$/)]"
            },
            {
                "matchesJsonPath": "$[?(@.age =~ /^[0-9]{1,3}$/)]"
            },
            {
                "matchesJsonPath": "$[?(@.height =~ /^[0-9]\\.[0-9]{1,2}$/)]"
            },
            {
                "matchesJsonPath": "$[?(@.interests)]"
            },
            {
                "matchesJsonPath": "$[?(@.birthDate =~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)]"
            },
            {
                "matchesJsonPath": "$[?(@.verified == true || @.verified == false)]"
            }
        ]
    },
    "response": {
        "status": 404,
        "headers": {
            "Content-Type": "application/json"
        },
        "bodyFileName": "persons/errorResponse-404.json"
    }
}