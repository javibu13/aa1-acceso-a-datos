{
    "priority": 1,
    "request": {
        "method": "POST",
        "urlPath": "/conferences",
        "headers": {
            "Content-Type": {
                "equalTo": "application/json"
            }
        },
        "bodyPatterns": [
            {
                "matchesJsonPath": "$[?(@.name && @.name =~ /^[a-zA-Z0-9 ]{3,50}$/)]"
            },
            {
                "matchesJsonPath": "$[?(@.capacity && @.capacity =~ /^[0-9]{1,3}$/)]"
            },
            {
                "matchesJsonPath": "$[?(@.budget && @.budget =~ /^[0-9]{1,6}$/)]"
            },
            {
                "matchesJsonPath": "$[?(@.online == true || @.online == false)]"
            },
            {
                "matchesJsonPath": "$[?(@.startDate && @.startDate =~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)]"
            },
            {
                "matchesJsonPath": "$[?(@.place && @.place =~ /^[0-9]+$/)]"
            },
            {
                "matchesJsonPath": "$[?(@.organizer && @.organizer =~ /^[0-9]+$/)]"
            }
        ]
    },
    "response": {
        "status": 201,
        "headers": {
            "Content-Type": "application/json"
        },
        "jsonBody": {
            "id": 2,
            "name": "{{jsonPath request.body '$.name'}}",
            "capacity": "{{jsonPath request.body '$.capacity'}}",
            "budget": "{{jsonPath request.body '$.budget'}}",
            "online": "{{jsonPath request.body '$.online'}}",
            "startDate": "{{jsonPath request.body '$.startDate'}}",
            "place": {
                "id": "{{jsonPath request.body '$.place'}}",
                "name": "Place 1",
                "address": "Fake Street 123",
                "capacity": 100,
                "area": 200.0,
                "inaugurationDate": "2025-01-01",
                "hasParking": true,
                "equipment": "Projector, Whiteboard"
            },
            "organizer": {
                "id": "{{jsonPath request.body '$.organizer'}}",
                "firstName": "Javier",
                "lastName": "Sanz",
                "email": "javier@sanz.com",
                "age": 28,
                "height": 1.75,
                "interests": "Tech, 3D, videogames, etc",
                "birthDate": "1996-05-29",
                "verified": false
            }
        },
        "transformers": [
            "response-template"
        ]
    }
}