{
    "priority": 1,
    "request": {
        "method": "PUT",
        "urlPath": "/persons/1",
        "headers": {
            "Content-Type": {
                "equalTo": "application/json"
            }
        },
        "bodyPatterns": [
            {
                "matchesJsonPath": "$[?(@.firstName)]"
            },
            {
                "matchesJsonPath": "$[?(@.lastName)]"
            },
            {
                "matchesJsonPath": "$[?(@.email =~ /^[^@]+@[^@]+\\.[^@]+$/)]"
            },
            {
                "matchesJsonPath": "$[?(@.pass =~ /^[a-f0-9]{40}$/)]"
            },
            {
                "matchesJsonPath": "$[?(@.age =~ /^[0-9]{1,3}$/)]"
            },
            {
                "matchesJsonPath": "$[?(@.height =~ /^[0-9]\\.[0-9]{1,2}$/)]"
            },
            {
                "matchesJsonPath": "$[?(@.interests)]"
            },
            {
                "matchesJsonPath": "$[?(@.birthDate =~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)]"
            },
            {
                "matchesJsonPath": "$[?(@.verified == true || @.verified == false)]"
            }
        ]
    },
    "response": {
        "status": 202,
        "headers": {
            "Content-Type": "application/json"
        },
        "jsonBody": {
            "id": 1,
            "firstName": "{{jsonPath request.body '$.firstName'}}",
            "lastName": "{{jsonPath request.body '$.lastName'}}",
            "email": "{{jsonPath request.body '$.email'}}",
            "age": "{{jsonPath request.body '$.age'}}",
            "height": "{{jsonPath request.body '$.height'}}",
            "interests": "{{jsonPath request.body '$.interests'}}",
            "birthDate": "{{jsonPath request.body '$.birthDate'}}",
            "verified": "{{jsonPath request.body '$.verified'}}"
        },
        "transformers": [
            "response-template"
        ]
    }
}